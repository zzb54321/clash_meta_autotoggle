<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <Switch
            android:id="@+id/switch_enabled"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/enable_auto_toggle"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/text_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/text_permissions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textSize="14sp" />

        <Button
            android:id="@+id/button_permissions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/grant_permissions" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/section_rules"
            android:textSize="16sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/container_rules"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/button_add_current"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/add_current_wifi" />

            <Button
                android:id="@+id/button_add_manual"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/add_manual" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/section_default_action"
            android:textSize="16sp"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/group_default_action"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/radio_default_keep"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/default_keep" />

            <RadioButton
                android:id="@+id/radio_default_enable"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/default_enable" />

            <RadioButton
                android:id="@+id/radio_default_disable"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/default_disable" />
        </RadioGroup>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/section_client"
            android:textSize="16sp"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/group_client"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/radio_client_cmfa"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/client_cmfa" />

            <RadioButton
                android:id="@+id/radio_client_flclash"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/client_flclash" />
        </RadioGroup>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/section_package"
            android:textSize="16sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/input_package"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/package_hint"
            android:importantForAutofill="no"
            android:inputType="text"
            android:maxLines="1" />

        <Button
            android:id="@+id/button_save_package"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/save" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/help_text"
            android:textSize="13sp" />
    </LinearLayout>
</ScrollView>
